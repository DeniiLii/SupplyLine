# Путь к SQLite (локальный режим и шаблон песочницы)
SUPPLYLINE_DB=db/supplyline.sqlite3
# 0 — моки без задержки (тесты), 1 — задержка 0,1–0,8 с (показ)
SUPPLYLINE_MOCK_LATENCY=1
# 1 — песочница на посетителя (публичное демо), 0 — одна общая БД (локально)
SUPPLYLINE_SANDBOX=0
# Папка копий БД посетителей в режиме песочницы
SUPPLYLINE_SESSIONS_DIR=db/sessions
# Порт HTTP-сервера (Docker, хостинг)
PORT=8000
